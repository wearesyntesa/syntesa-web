{
  "name": "syntesa-web",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write .",
    "start": "npx serve build/client",
    "preview": "vite preview --outDir build/client",
    "typecheck": "tsc",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.2.8",
    "@react-router/node": "7.13.0",
    "framer-motion": "12.38.0",
    "isbot": "5",
    "lenis": "1.3.23",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "5.6.0",
    "react-router": "7.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@cloudflare/vite-plugin": "1.37.0",
    "@cloudflare/workers-types": "4.20260522.1",
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@playwright/test": "1.60.0",
    "@react-router/dev": "7.13.0",
    "@tailwindcss/vite": "4.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "husky": "9.1.7",
    "lint-staged": "17.0.4",
    "tailwindcss": "4.3.0",
    "terser": "5.48.0",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-imagetools": "10.0.0",
    "vite-tsconfig-paths": "6.1.1",
    "wrangler": "4.93.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "biome check --write"
    ],
    "*.{json,css}": [
      "biome format --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
